="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="463.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-10" source="g1_0" target="g1_0_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#15966A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="463.33333333333337" /><mxPoint x="1323" y="369.83333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-11" source="g1_0" target="g1_0_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#15966A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="463.33333333333337" /><mxPoint x="1323" y="551.3333333333334" /></Array></mxGeometry></mxCell><mxCell id="edge-12" source="root" target="g1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="940.0" /></Array></mxGeometry></mxCell><mxCell id="edge-13" source="g1_1" target="g1_1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#C27B23;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="940.0" /><mxPoint x="1323" y="852.0" /></Array></mxGeometry></mxCell><mxCell id="edge-14" source="g1_1" target="g1_1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#C27B23;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="940.0" /><mxPoint x="1323" y="1028.0" /></Array></mxGeometry></mxCell><mxCell id="edge-15" source="root" target="g1_2" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="1416.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-16" source="g1_2" target="g1_2_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#BB5266;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="1416.6666666666667" /><mxPoint x="1323" y="1328.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-17" source="g1_2" target="g1_2_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#BB5266;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="1416.6666666666667" /><mxPoint x="1323" y="1510.1666666666667" /></Array></mxGeometry></mxCell><mxCell id="legend" value="А — администратор; РП — предприятие; РОт — отдел; РПр — проект; С — сотрудник. UI — интерфейс; ФОН/API — без отдельного экрана; ИДЕЯ — предложение." style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontFamily=Onest;fontColor=#647D91;" vertex="1" parent="1"><mxGeometry x="48" y="1725" width="1650" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page-02" name="02 Главная / Моя страница"><mxGraphModel dx="1800" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1800" background="#F3FAFC"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="page-title" value="02 · Главная / Моя страница" style="text;html=1;align=left;fontSize=30;fontFamily=Onest;fontStyle=1;fontColor=#10243A" vertex="1" parent="1"><mxGeometry x="48" y="35" width="1650" height="60" as="geometry" /></mxCell><mxCell id="page-subtitle" value="Ветви: раздел → функция → действие и результат. Ограничения роли указаны в каждом узле." style="text;html=1;align=left;fontSize=16;fontFamily=Onest;fontColor=#647D91" vertex="1" parent="1"><mxGeometry x="48" y="105" width="1650" height="50" as="geometry" /></mxCell><mxCell id="g-1_0" value="&lt;span style=&quot;font-size:20px;color:#109E99;font-weight:600&quot;&gt;Обзор состояния&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="417.33333333333337" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Сообщение о команде&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Верхний баннер&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Посмотреть состояние нагрузки и риска.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Текст зависит от доступных данных.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="295.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Перейти к аналитике&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Баннер → кнопки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Открыть загрузку или кадровый риск.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Дальнейшая работа в профильном разделе.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="471.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_1" value="&lt;span style=&quot;font-size:20px;color:#277CCB;font-weight:600&quot;&gt;Рабочие KPI&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="894.0" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Задачи и просрочки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточки KPI&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Нажать нужный показатель.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Открывается список задач с условием.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="772.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Загрузка и проекты&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточки KPI&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Перейти к нагрузке или проектам.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Показатели ведут к исходным данным.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="948.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_2" value="&lt;span style=&quot;font-size:20px;color:#7761C5;font-weight:600&quot;&gt;Кадровые KPI&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="1370.6666666666667" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_2_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;HIGH / CRITICAL&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточки риска&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Нажать уровень кадрового риска.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Открывается /attrition с фильтром.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1248.6666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_2_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Компоновка по роли&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Сетка KPI&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Роль с кадровым доступом видит шесть KPI.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Без него — четыре; значения не подменяются.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1424.6666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_0" value="&lt;span style=&quot;font-size:20px;color:#15966A;font-weight:600&quot;&gt;Команда&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="417.33333333333337" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Загрузка подразделений&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Виджет загрузки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Сравнить загрузку доступных подразделений.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: «Подробнее» открывает раздел нагрузки.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="295.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Статус работы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Круговая диаграмма&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Посмотреть распределение задач.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Это рабочие статусы, не прогноз ухода.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="471.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_1" value="&lt;span style=&quot;font-size:20px;color:#C27B23;font-weight:600&quot;&gt;Кадровый риск&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="894.0" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Сохранённые прогнозы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Виджет риска&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Открыть сотрудника или аналитику.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Используются сохранённые прогнозы.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="772.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Нет прогнозов&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;ВАЖНО · Пустое состояние виджета&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Прочитать причину отсутствия данных.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Карта не обещает выдуманных рекомендаций.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="948.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_2" value="&lt;span style=&quot;font-size:20px;color:#BB5266;font-weight:600&quot;&gt;Ближайшие задачи&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="1370.6666666666667" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_2_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Задачи команды&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Нижние колонки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Выбрать карточку задачи.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Открывается /tasks/{id}.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1248.6666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_2_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Все задачи&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Виджет → «Все задачи»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Открыть полную рабочую очередь.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Доступны поиск и фильтры.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1424.6666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="root" value="&lt;span style=&quot;font-size:26px;color:white;font-weight:600&quot;&gt;Главная / Моя страница&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#B9E5E4;font-weight:400&quot;&gt;/dashboard&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wra