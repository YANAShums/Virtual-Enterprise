"><Array as="points"><mxPoint x="477" y="1416.6666666666667" /><mxPoint x="477" y="1504.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-9" source="root" target="g1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="463.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-10" source="g1_0" target="g1_0_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#15966A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="463.33333333333337" /><mxPoint x="1323" y="369.83333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-11" source="g1_0" target="g1_0_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#15966A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="463.33333333333337" /><mxPoint x="1323" y="551.3333333333334" /></Array></mxGeometry></mxCell><mxCell id="edge-12" source="root" target="g1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="940.0" /></Array></mxGeometry></mxCell><mxCell id="edge-13" source="g1_1" target="g1_1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#C27B23;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="940.0" /><mxPoint x="1323" y="852.0" /></Array></mxGeometry></mxCell><mxCell id="edge-14" source="g1_1" target="g1_1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#C27B23;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="940.0" /><mxPoint x="1323" y="1028.0" /></Array></mxGeometry></mxCell><mxCell id="edge-15" source="root" target="g1_2" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="1416.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-16" source="g1_2" target="g1_2_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#BB5266;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="1416.6666666666667" /><mxPoint x="1323" y="1323.1666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-17" source="g1_2" target="g1_2_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#BB5266;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="1416.6666666666667" /><mxPoint x="1323" y="1510.1666666666667" /></Array></mxGeometry></mxCell><mxCell id="legend" value="А — администратор; РП — предприятие; РОт — отдел; РПр — проект; С — сотрудник. UI — интерфейс; ФОН/API — без отдельного экрана; ИДЕЯ — предложение." style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontFamily=Onest;fontColor=#647D91;" vertex="1" parent="1"><mxGeometry x="48" y="1725" width="1650" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page-05" name="05 Проекты"><mxGraphModel dx="1800" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1800" background="#F3FAFC"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="page-title" value="05 · Проекты" style="text;html=1;align=left;fontSize=30;fontFamily=Onest;fontStyle=1;fontColor=#10243A" vertex="1" parent="1"><mxGeometry x="48" y="35" width="1650" height="60" as="geometry" /></mxCell><mxCell id="page-subtitle" value="Ветви: раздел → функция → действие и результат. Ограничения роли указаны в каждом узле." style="text;html=1;align=left;fontSize=16;fontFamily=Onest;fontColor=#647D91" vertex="1" parent="1"><mxGeometry x="48" y="105" width="1650" height="50" as="geometry" /></mxCell><mxCell id="g-1_0" value="&lt;span style=&quot;font-size:20px;color:#109E99;font-weight:600&quot;&gt;Каталог&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="417.33333333333337" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Посмотреть проекты&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Sidebar → «Проекты»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Открыть список активных проектов.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Видны проекты и основные показатели.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="295.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Открыть проект&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · /projects/{id}&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Выбрать нужный проект.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Открываются сведения и рабочие связи.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="471.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_1" value="&lt;span style=&quot;font-size:20px;color:#277CCB;font-weight:600&quot;&gt;Создание&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="894.0" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Новый проект&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Проекты → «Создать проект»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Заполнить код, название, сроки и параметры.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Создаётся запись проекта.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="772.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Состав команды&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Форма проекта&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Выбрать участников проекта.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Их можно назначать на задачи проекта.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="948.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_2" value="&lt;span style=&quot;font-size:20px;color:#7761C5;font-weight:600&quot;&gt;Изменения&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="1370.6666666666667" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_2_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Редактировать проект&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточка → «Редактировать»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Изменить параметры и команду.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Изменения сохраняются и аудируются.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1248.6666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_2_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Проверка формы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;ВАЖНО · Создание / редактирование&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Исправить недопустимые значения.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Ошибки возвращаются в ту же форму.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1424.6666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_0" value="&lt;span style=&quot;font-size:20px;color:#15966A;font-weight:600&quot;&gt;Связь с работой&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="536.5" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Открыть доску проекта&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточка → «Открыть доску»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Перейти в /kanban?projectId=…&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Показываются задачи этого проекта.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="414.5" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Участники&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточка проекта&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Посмотреть команду и исполнителей.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Карточка сотрудника открывается по ссылке.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="590.5" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_1" value="&lt;span style=&quot;font-size:20px;color:#C27B23;font-weight:600&quot;&gt;Ограничения&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="1251.5" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Проект и назначение&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;ВАЖНО · Создание задачи&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Исполнитель должен входить в команду.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Назначение постороннего отклоняется.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1129.5" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Права редактирования&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;ВАЖНО · Контроллер проекта&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: РОт и С не имеют формы управления проектом.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Просмотр не означает право изменения.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1305.5" width="405" height="160" as="geometry" /></mxCell><mxCell id="root" value="&lt;span style=&quot;font-size:26px;color:white;font-weight:600&quot;&gt;Проекты&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#B9E5E4;font-weight:400&quot;&gt;/projects&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#073F48;strokeColor=#073F48;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="760" y="845" width="280" height="190" as="geometry" /></mxCell><mxCell id="edge-0" source="root" target="g-1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="463.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-1" source="g-1_0" target="g-1_0_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#109E99;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="463.33333333333337" /><mxPoint x="477" y="375.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-2" source="g-1_0" target="g-1_0_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#109E99;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="463.33333333333337" /><mxPoint x="477" y="551.3333333333334" /></Array></mxGeometry></mxCell><mxCell id="edge-3" source="root" target="g-1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="940.0" /></Array></mxGeometry></mxCell><mxCell id="edge-4" source="g-1_1" target="g-1_1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#277CCB;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="940.0" /><mxPoint x="477" y="852.0" /></Array></mxGeometry></mxCell><mxCell id="edge-5" source="g-1_1" target="g-1_1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#277CCB;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="940.0" /><mxPoint x="477" y="1028.0" /></Array></mxGeometry></mxCell><mxCell id="edge-6" source="root" target="g-1_2" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="1416.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-7" source="g-1_2" target="g-1_2_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#7761C5;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="1416.6666666666667" /><mxPoint x="477" y="1328.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-8" source="g-1_2" target="g-1_2_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#7761C5;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="1416.6666666666667" /><mxPoint x="477" y="1504.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-9" source="root" target="g1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="582.5" /></Array></mxGeometry></mxCell><mxCell id="edge-10" source="g1_0" target="g1_0_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#15966A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="582.5" /><mxPoint x="1323" y="494.5" /></Array></mxGeometry></mxCell><mxCell id="edge-11" source="g1_0" target="g1_0_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#15966A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="582.5" /><mxPoint x="1323" y="670.5" /></Array></mxGeometry></mxCell><mxCell id="edge-12" source="root" target="g1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="1297.5" /></Array></mxGeometry></mxCell><mxCell id="edge-13" source="g1_1" target="g1_1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#C27B23;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="1297.5" /><mxPoint x="1323" y="1209.5" /></Array></mxGeometry></mxCell><mxCell id="edge-14" source="g1_1" target="g1_1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#C27B23;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="1297.5" /><mxPoint x="1323" y="1385.5" /></Array></mxGeometry></mxCell><mxCell id="legend" value="А — администратор; РП — предприятие; РОт — отдел; РПр — проект; С — сотрудник. UI — интерфейс; ФОН/API — без отдельного экрана; ИДЕЯ — предложение." style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontFamily=Onest;fontColor=#647D91;" vertex="1" parent="1"><mxGeometry x="48" y="1725" width="1650" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page-06" name="06 Команда и сотрудники"><mxGraphModel dx="1800" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1800" background="#F3FAFC"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="page-title" value="06 · Команда и сотрудники" style="text;html=1;align=left;fontSize=30;fontFamily=Onest;fontStyle=1;fontColor=#10243A" vertex="1" parent="1"><mxGeometry x="48" y="35" width="1650" height="60" as="geometry" /></mxCell><mxCell id="page-subtitle" value="Ветви: раздел → функция → действие и результат. Ограничения роли указаны в каждом узле." style="text;html=1;align=left;fontSize=16;fontFamily=Onest;fontColor=#647D91" vertex="1" parent="1"><mxGeometry x="48" y="105" width="1650" height="50" as="geometry" /></mxCell><mxCell id="g-1_0" value="&lt;span style=&quot;font-size:20px;color:#109E99;font-weight:600&quot;&gt;Список команды&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="417.33333333333337" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Фильтры и сортировка&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Sidebar → «Команда»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Выбрать подразделение, загрузку, порядок.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Список и краткий просмотр меняются.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="295.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Архивные карточки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Список → показ архива&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Включить архивные записи.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Доступно администратору.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="471.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_1" value="&lt;span style=&quot;font-size:20px;color:#277CCB;font-weight:600&quot;&gt;Кадровая запись&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="894.0" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Добавить сотрудника&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · /employees/new&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Заполнить кадровые данные и сохранить.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Открывается созданная карточка.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="772.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Перевод / статус / увольнение&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточка → «Редактировать»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Изменить данные; указать причину и даты.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: История и событие увольнения сохраняются.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="948.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_2" value="&lt;span style=&quot;font-size:20px;color:#7761C5;font-weight:600&quot;&gt;Основные вкладки&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="1370.6666666666667" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_2_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Обзор / Задачи / График&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточка → вкладки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Просмотреть контакты, задачи и график.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Данные связаны с рабочей нагрузкой.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1243.1666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_2_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Кадровая история&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточка → «Кадровая история»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Посмотреть назначения и статусы.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Показываются реально сохранённые изменения.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1419.1666666666667" width="405" height="171" as="geometry" /></mxCell><mxCell id="g1_0" value="&lt;span style=&quot;font-size:20px;color:#15966A;font-weight:600&quot;&gt;Отсутствия&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="417.33333333333337" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Добавить / изменить период&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Вкладка «Отсутствия»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Указать тип, время и состояние.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Подтверждённые периоды влияют на нагрузку.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="289.83333333333337" width="405" height="171" as="geometry" /></mxCell><mxCell id="g1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Отменить отсутствие&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Период → кнопка отмены&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Подтвердить действие для текущей версии.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Запись получает состояние отмены.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="476.83333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_1" value="&lt;span style=&quot;font-size:20px;color:#C27B23;font-weight:600&quot;&gt;Навыки&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="894.0" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Посмотреть навыки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточка → «Навыки»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Изучить уровни и опыт сотрудника.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Видны сохранённые компетенции.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="766.5" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Добавить / изменить / убрать&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Вкладка → действия записи&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Указать навык, уровень и опыт.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Данные используются при подборе исполнителя.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="942.5" width="405" height="171" as="geometry" /></mxCell><mxCell id="g1_2" value="&lt;span style=&quot;font-size:20px;color:#BB5266;font-weight:600&quot;&gt;Кадровый прогноз&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="1370.6666666666667" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_2_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Вкладка «Текучесть»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · /employees/{id}#employeeAttrition&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Изучить риск, факторы, историю и рекомендации.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Для РОт — только своё подразделение.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1228.1666666666667" width="405" height="171" as="geometry" /></mxCell><mxCell id="g1_2_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Пересчитать сотрудника&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Вкладка → «Пересчитать»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Запросить обновлённый прогноз активного работника.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: При отказе ML возможен сохранённый прогноз.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1415.1666666666667" width="405" height="190" as="geometry" /></mxCell><mxCell id="root" value="&lt;span style=&quot;font-size:26px;color:white;font-weight:600&quot;&gt;Команда и сотрудники&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#B9E5E4;font-weight:400&quot;&gt;/employees&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#073F48;strokeColor=#073F48;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="760" y="845" width="280" height="190" as="geometry" /></mxCell><mxCell id="edge-0" source="root" target="g-1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="463.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-1" source="g-1_0" target="g-1_0_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#109E99;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="463.33333333333337" /><mxPoint x="477" y="375.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-2" source="g-1_0" target="g-1_0_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#109E99;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="463.33333333333337" /><mxPoint x="477" y="551.3333333333334" /></Array></mxGeometry></mxCell><mxCell id="edge-3" source="root" target="g-1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="940.0" /></Array></mxGeometry></mxCell><mxCell id="edge-4" source="g-1_1" target="g-1_1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#277CCB;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="940.0" /><mxPoint x="477" y="852.0" /></Array></mxGeometry></mxCell><mxCell id="edge-5" source="g-1_1" target="g-1_1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#277CCB;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="940.0" /><mxPoint x="477" y="1028.0" /></Array></mxGeometry></mxCell><mxCell id="edge-6" source="root" target="g-1_2" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="1416.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-7" source="g-1_2" target="g-1_2_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#7761C5;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="1416.6666666666667" /><mxPoint x="477" y="1323.1666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-8" source="g-1_2" target="g-1_2_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#7761C5;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="1416.6666666666667" /><mxPoint x="477" y="1504.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-9" source="root" target="g1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="463.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-10" source="g1_0" target="g1_0_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#15966A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="463.33333333333337" /><mxPoint x="1323" y="375.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-11" source="g1_0" target="g1_0_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#15966A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="463.33333333333337" /><mxPoint x="1323" y="556.8333333333334" /></Array></mxGeometry></mxCell><mxCell id="edge-12" source="root" target="g1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="940.0" /></Array></mxGeometry></mxCell><mxCell id="edge-13" source="g1_1" target="g1_1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#C27B23;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="940.0" /><mxPoint x="1323" y="846.5" /></Array></mxGeometry></mxCell><mxCell id="edge-14" source="g1_1" target="g1_1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#C27B23;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="940.0" /><mxPoint x="1323" y="1028.0" /></Array></mxGeometry></mxCell><mxCell id="edge-15" source="root" target="g1_2" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="1416.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-16" source="g1_2" target="g1_2_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#BB5266;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="1416.6666666666667" /><mxPoint x="1323" y="1313.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-17" source="g1_2" target="g1_2_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#BB5266;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="1416.6666666666667" /><mxPoint x="1323" y="1510.1666666666667" /></Array></mxGeometry></mxCell><mxCell id="legend" value="А — администратор; РП — предприятие; РОт — отдел; РПр — проект; С — сотрудник. UI — интерфейс; ФОН/API — без отдельного экрана; ИДЕЯ — предложение." style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontFamily=Onest;fontColor=#647D91;" vertex="1" parent="1"><mxGeometry x="48" y="1725" width="1650" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page-07" name="07 Аналитика загрузки"><mxGraphModel dx="1800" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1800" background="#F3FAFC"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="page-title" value="07 · Аналитика загрузки" style="text;html=1;align=left;fontSize=30;fontFamily=Onest;fontStyle=1;fontColor=#10243A" vertex="1" parent="1"><mxGeometry x="48" y="35" width="1650" height="60" as="geometry" /></mxCell><mxCell id="page-subtitle" value="Ветви: раздел → функция → действие и результат. Ограничения роли указаны в каждом узле." style="text;html=1;align=left;fontSize=16;fontFamily=Onest;fontColor=#647D91" vertex="1" parent="1"><mxGeometry x="48" y="105" width="1650" height="50" as="geometry" /></mxCell><mxCell id="g-1_0" value="&lt;span style=&quot;font-size:20px;color:#109E99;font-weight:600&quot;&gt;Открыть аналитику&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="417.33333333333337" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Раздел загрузки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Sidebar → «Аналитика»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Открыть /workload.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Экран называется «Загруженность».&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="295.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Период в TopBar&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Кнопка периода, если показана&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Перейти к нагрузке за указанные даты.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Это ссылка, не отдельный глобальный фильтр.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="471.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_1" value="&lt;span style=&quot;font-size:20px;color:#277CCB;font-weight:600&quot;&gt;Отбор&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="894.0" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Подразделение&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Форма фильтров&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Выбрать подразделение.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: В расчёте остаются нужные сотрудники.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="772.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Диапазон дат&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Поля начала и окончания&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Применить период; по умолчанию 7 дней.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Дневная таблица пересчитывается.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="948.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_2" value="&lt;span style=&quot;font-size:20px;color:#7761C5;font-weight:600&quot;&gt;Основная таблица&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="1370.6666666666667" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_2_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Доступно / назначено / процент&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Строки сотрудников&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Сравнить часы и цвет состояния.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Основа — график, календарь, задачи, отсутствия.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1243.1666666666667" width="405" height="171" as="geometry" /></mxCell><mxCell id="g-1_2_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Состояния нагрузки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Дневные ячейки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Читать процент вместе с подписью.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: WARNING &amp;gt;100%; CRITICAL &amp;gt;120%.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1430.1666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_0" value="&lt;span style=&quot;font-size:20px;color:#15966A;font-weight:600&quot;&gt;Детализация дня&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="536.5" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Открыть день&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Клик по дневной ячейке&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Открыть боковую панель дня.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Доступные часы, назначенные часы и статус.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="414.5" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Перейти к сотруднику&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Панель → «Карточка сотрудника»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Открыть /employees/{id}.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Можно изучить график и отсутствия.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="590.5" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_1" value="&lt;span style=&quot;font-size:20px;color:#C27B23;font-weight:600&quot;&gt;Объяснение расчёта&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="1251.5" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Плановая оценка&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;ВАЖНО · Расчёт workload-сервиса&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Учитывать рабочие часы и назначенные задачи.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Это не самостоятельный учёт фактических часов.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1118.5" width="405" height="171" as="geometry" /></mxCell><mxCell id="g1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Нет сервиса&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;ВАЖНО · Сообщение об ошибке&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Повторить после восстановления сервиса.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Пустой результат не трактуется как нулевая нагрузка.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1305.5" width="405" height="171" as="geometry" /></mxCell><mxCell id="root" value="&lt;span style=&quot;font-size:26px;color:white;font-weight:600&quot;&gt;Аналитика загрузки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#B9E5E4;font-weight:400&quot;&gt;/workload&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#073F48;strokeColor=#073F48;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="760" y="845" width="280" height="190" as="geometry" /></mxCell><mxCell id="edge-0" source="root" target="g-1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="463.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-1" source="g-1_0" target="g-1_0_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#109E99;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="463.33333333333337" /><mxPoint x="477" y="375.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-2" source="g-1_0" target="g-1_0_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#109E99;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="463.33333333333337" /><mxPoint x="477" y="551.3333333333334" /></Array></mxGeometry></mxCell><mxCell id="edge-3" source="root" target="g-1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="940.0" /></Array></mxGeometry></mxCell><mxCell id="edge-4" source="g-1_1" target="g-1_1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#277CCB;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="940.0" /><mxPoint x="477" y="852.0" /></Array></mxGeometry></mxCell><mxCell id="edge-5" source="g-1_1" target="g-1_1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#277CCB;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="940.0" /><mxPoint x="477" y="1028.0" /></Array></mxGeometry></mxCell><mxCell id="edge-6" source="root" target="g-1_2" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="1416.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-7" source="g-1_2" target="g-1_2_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#7761C5;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="1416.6666666666667" /><mxPoint x="477" y="1328.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-8" source="g-1_2" target="g-1_2_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#7761C5;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="1416.6666666666667" /><mxPoint x="477" y="1510.1666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-9" source="root" target="g1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="582.5" /></Array></mxGeometry></mxCell><mxCell id="edge-10" source="g1_0" target="g1_0_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#15966A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="582.5" /><mxPoint x="1323" y="494.5" /></Array></mxGeometry></mxCell><mxCell id="edge-11" source="g1_0" target="g1_0_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#15966A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="582.5" /><mxPoint x="1323" y="670.5" /></Array></mxGeometry></mxCell><mxCell id="edge-12" source="root" target="g1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="1297.5" /></Array></mxGeometry></mxCell><mxCell id="edge-13" source="g1_1" target="g1_1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#C27B23;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="1297.5" /><mxPoint x="1323" y="1204.0" /></Array></mxGeometry></mxCell><mxCell id="edge-14" source="g1_1" target="g1_1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#C27B23;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="1297.5" /><mxPoint x="1323" y="1391.0" /></Array></mxGeometry></mxCell><mxCell id="legend" value="А — администратор; РП — предприятие; РОт — отдел; РПр — проект; С — сотрудник. UI — интерфейс; ФОН/API — без отдельного экрана; ИДЕЯ — предложение." style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontFamily=Onest;fontColor=#647D91;" vertex="1" parent="1"><mxGeometry x="48" y="1725" width="1650" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page-08" name="08 Прогнозы текучести"><mxGraphModel dx="1800" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1800" background="#F3FAFC"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="page-title" value="08 · Прогнозы текучести" style="text;html=1;align=left;fontSize=30;fontFamily=Onest;fontStyle=1;fontColor=#10243A" vertex="1" parent="1"><mxGeometry x="48" y="35" width="1650" height="60" as="geometry" /></mxCell><mxCell id="page-subtitle" value="Ветви: раздел → функция → действие и результат. Ограничения роли указаны в каждом узле." style="text;html=1;align=left;fontSize=16;fontFamily=Onest;fontColor=#647D91" vertex="1" parent="1"><mxGeometry x="48" y="105" width="1650" height="50" as="geometry" /></mxCell><mxCell id="g-1_0" value="&lt;span style=&quot;font-size:20px;color:#109E99;font-weight:600&quot;&gt;Доступ и область&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="417.33333333333337" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Открыть прогнозы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Sidebar → «Текучесть»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Перейти в /attrition.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: РП/А — организация; РОт — свой отдел.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="289.83333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Отдел и права&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;ВАЖНО · Серверная область данных&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Просматривать только разрешённых сотрудников.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: РПр и С не имеют кадрового доступа.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="465.83333333333337" width="405" height="171" as="geometry" /></mxCell><mxCell id="g-1_1" value="&lt;span style=&quot;font-size:20px;color:#277CCB;font-weight:600&quot;&gt;Фильтры&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="894.0" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Отобрать прогнозы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Панель «Фильтры»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Период, отдел, должность, проект, риск, вероятность.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Применение меняет выборку и показатели.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="766.5" width="405" height="171" as="geometry" /></mxCell><mxCell id="g-1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Мобильный режим&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Заголовок фильтров&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Раскрыть панель; применить или сбросить.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Счётчик показывает активные условия.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="953.5" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_2" value="&lt;span style=&quot;font-size:20px;color:#7761C5;font-weight:600&quot;&gt;Показатели&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="1370.6666666666667" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_2_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;KPI и распределение&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточки / диаграммы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Изучить HIGH, CRITICAL и среднюю вероятность.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Отображаются данные выбранной выборки.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1243.1666666666667" width="405" height="171" as="geometry" /></mxCell><mxCell id="g-1_2_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;История и динамика&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · График по периоду&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Сравнить сохранённые расчёты.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Без истории показывается пустое состояние.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1430.1666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_0" value="&lt;span style=&quot;font-size:20px;color:#15966A;font-weight:600&quot;&gt;Разбор сотрудника&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="417.33333333333337" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Таблица сотрудников&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Строка → сотрудник&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Открыть кадровую карточку.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Риск, нагрузка, факторы, версия и дата.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="289.83333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Устаревший прогноз&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;ВАЖНО · Метка устаревания&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Учитывать состояние сохранённого результата.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Ошибка ML не выдаётся за свежий расчёт.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="465.83333333333337" width="405" height="171" as="geometry" /></mxCell><mxCell id="g1_1" value="&lt;span style=&quot;font-size:20px;color:#C27B23;font-weight:600&quot;&gt;Обновление&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="894.0" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Массовый пересчёт&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · «Пересчитать прогнозы»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Запустить расчёт активных сотрудников.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Показаны количества успехов и ошибок.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="772.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Один сотрудник&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточка → вкладка «Текучесть»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Нажать «Пересчитать».&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: РОт может обновлять свой отдел.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="948.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_2" value="&lt;span style=&quot;font-size:20px;color:#BB5266;font-weight:600&quot;&gt;Смысл результата&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="1370.6666666666667" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_2_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Горизонт 90 дней&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Вероятность и уровень риска&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Сопоставить результат с кадровой ситуацией.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Пороги: 0,30 / 0,60 / 0,80.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1248.6666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_2_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Рекомендательный характер&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;ВАЖНО · Примечание страницы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Изучить причины и обсудить меры с HR.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Автоматического решения об увольнении нет.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1424.6666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="root" value="&lt;span style=&quot;font-size:26px;color:white;font-weight:600&quot;&gt;Прогнозы текучести&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#B9E5E4;font-weight:400&quot;&gt;/attrition&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#073F48;strokeColor=#073F48;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="760" y="845" width="280" height="190" as="geometry" /></mxCell><mxCell id="edge-0" source="root" target="g-1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="463.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-1" source="g-1_0" target="g-1_0_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#109E99;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="463.33333333333337" /><mxPoint x="477" y="369.83333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-2" source="g-1_0" target="g-1_0_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#109E99;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="463.33333333333337" /><mxPoint x="477" y="551.3333333333334" /></Array></mxGeometry></mxCell><mxCell id="edge-3" source="root" target="g-1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="940.0" /></Array></mxGeometry></mxCell><mxCell id="edge-4" source="g-1_1" target="g-1_1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#277CCB;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="940.0" /><mxPoint x="477" y="852.0" /></Array></mxGeometry></mxCell><mxCell id="edge-5" source="g-1_1" target="g-1_1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#277CCB;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="940.0" /><mxPoint x="477" y="1033.5" /></Array></mxGeometry></mxCell><mxCell id="edge-6" source="root" targ