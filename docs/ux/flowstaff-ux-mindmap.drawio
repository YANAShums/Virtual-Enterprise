tArrow=none;rounded=1;html=1;strokeColor=#C27B23;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="940.0" /><mxPoint x="1323" y="852.0" /></Array></mxGeometry></mxCell><mxCell id="edge-14" source="g1_1" target="g1_1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#C27B23;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="940.0" /><mxPoint x="1323" y="1028.0" /></Array></mxGeometry></mxCell><mxCell id="edge-15" source="root" target="g1_2" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="1416.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-16" source="g1_2" target="g1_2_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#BB5266;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="1416.6666666666667" /><mxPoint x="1323" y="1328.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-17" source="g1_2" target="g1_2_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#BB5266;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="1416.6666666666667" /><mxPoint x="1323" y="1504.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="legend" value="А — администратор; РП — предприятие; РОт — отдел; РПр — проект; С — сотрудник. UI — интерфейс; ФОН/API — без отдельного экрана; ИДЕЯ — предложение." style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontFamily=Onest;fontColor=#647D91;" vertex="1" parent="1"><mxGeometry x="48" y="1725" width="1650" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page-04" name="04 Kanban и создание задачи"><mxGraphModel dx="1800" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1800" background="#F3FAFC"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="page-title" value="04 · Kanban и создание задачи" style="text;html=1;align=left;fontSize=30;fontFamily=Onest;fontStyle=1;fontColor=#10243A" vertex="1" parent="1"><mxGeometry x="48" y="35" width="1650" height="60" as="geometry" /></mxCell><mxCell id="page-subtitle" value="Ветви: раздел → функция → действие и результат. Ограничения роли указаны в каждом узле." style="text;html=1;align=left;fontSize=16;fontFamily=Onest;fontColor=#647D91" vertex="1" parent="1"><mxGeometry x="48" y="105" width="1650" height="50" as="geometry" /></mxCell><mxCell id="g-1_0" value="&lt;span style=&quot;font-size:20px;color:#109E99;font-weight:600&quot;&gt;Контекст доски&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="417.33333333333337" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Выбрать проект&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Доски → список проектов&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Выбрать активный проект.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Доска загружает его задачи.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="295.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Отфильтровать карточки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Поиск / приоритет / просрочки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Задать условия в панели доски.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Видимость карточек меняется в браузере.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="471.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_1" value="&lt;span style=&quot;font-size:20px;color:#277CCB;font-weight:600&quot;&gt;Новая задача&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="894.0" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Открыть панель&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · «Создать задачу»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Ввести название, сроки, часы и навыки.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Для выбора исполнителя нужен расчёт.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="772.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Рассчитать кандидатов&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Панель → «Рассчитать»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Запросить нагрузку и подходящих участников.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Показаны объяснения и предупреждения.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="948.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_2" value="&lt;span style=&quot;font-size:20px;color:#7761C5;font-weight:600&quot;&gt;Назначение&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="1370.6666666666667" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_2_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Выбрать исполнителя&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Результаты расчёта&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Выбрать доступного участника проекта.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Становится доступно создание задачи.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1243.1666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_2_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Перегрузка / новый расчёт&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Панель создания&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Подтвердить критическую перегрузку, если нужно.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Изменившаяся нагрузка требует пересчёта.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1419.1666666666667" width="405" height="171" as="geometry" /></mxCell><mxCell id="g1_0" value="&lt;span style=&quot;font-size:20px;color:#15966A;font-weight:600&quot;&gt;Сохранение&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="417.33333333333337" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Создать задачу&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Панель → «Создать задачу»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Отправить заполненную форму.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Задача сохраняется и появляется на доске.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="289.83333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Недоступен расчёт&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;ВАЖНО · Ошибка workload-сервиса&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Дождаться восстановления и повторить.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Задача без проверенного расчёта не создаётся.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="465.83333333333337" width="405" height="171" as="geometry" /></mxCell><mxCell id="g1_1" value="&lt;span style=&quot;font-size:20px;color:#C27B23;font-weight:600&quot;&gt;Колонки&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="894.0" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Основной путь&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · PLANNED → IN_PROGRESS → REVIEW → DONE&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Перемещать карточку в допустимую колонку.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Сервер проверяет переход, роль и версию.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр / С: своя задача&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="772.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Отменённая задача&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;ВАЖНО · Статус CANCELLED&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Статус есть в бизнес-логике.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Отдельная колонка CANCELLED скрыта.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="948.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_2" value="&lt;span style=&quot;font-size:20px;color:#BB5266;font-weight:600&quot;&gt;Детализация&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="1370.6666666666667" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_2_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Открыть задачу&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточка на доске&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Нажать название или ключ.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Полное обсуждение и параметры — в карточке.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1237.6666666666667" width="405" height="171" as="geometry" /></mxCell><mxCell id="g1_2_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Вернуть из готового&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · DONE → IN_PROGRESS&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Вернуть задачу в работу допустимым переходом.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Изменение записывается в историю.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр / С: своя задача&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1424.6666666666667" width="405" height="171" as="geometry" /></mxCell><mxCell id="root" value="&lt;span style=&quot;font-size:26px;color:white;font-weight:600&quot;&gt;Kanban и создание задачи&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#B9E5E4;font-weight:400&quot;&gt;/kanban&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#073F48;strokeColor=#073F48;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="760" y="845" width="280" height="190" as="geometry" /></mxCell><mxCell id="edge-0" source="root" target="g-1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="463.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-1" source="g-1_0" target="g-1_0_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#109E99;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="463.33333333333337" /><mxPoint x="477" y="375.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-2" source="g-1_0" target="g-1_0_1" edge="1" parent="1" style="endArrow=none;startArro