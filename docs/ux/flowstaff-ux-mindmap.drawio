<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="page-00" name="00 Обзор"><mxGraphModel dx="1800" dy="1550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1550" background="#F3FAFC"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="page-title" value="FlowStaff AI — карта UX / UI" style="text;html=1;align=left;fontSize=30;fontFamily=Onest;fontStyle=1;fontColor=#10243A" vertex="1" parent="1"><mxGeometry x="48" y="35" width="1650" height="60" as="geometry" /></mxCell><mxCell id="page-subtitle" value="Ветви: раздел → функция → действие и результат. Ограничения роли указаны в каждом узле." style="text;html=1;align=left;fontSize=16;fontFamily=Onest;fontColor=#647D91" vertex="1" parent="1"><mxGeometry x="48" y="105" width="1650" height="50" as="geometry" /></mxCell><mxCell id="p01" value="&lt;span style=&quot;font-size:22px;color:#10243A;font-weight:600&quot;&gt;01  Вход и навигация&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#647D91;font-weight:400&quot;&gt;/login&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#10243A;font-weight:400&quot;&gt;Как попасть в систему и найти раздел&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#16B8B1;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1" link="data:page/id,page-01"><mxGeometry x="48" y="185" width="567" height="140" as="geometry" /></mxCell><mxCell id="p02" value="&lt;span style=&quot;font-size:22px;color:#10243A;font-weight:600&quot;&gt;02  Главная / Моя страница&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#647D91;font-weight:400&quot;&gt;/dashboard&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#10243A;font-weight:400&quot;&gt;Обзор команды и переход к работе&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#16B8B1;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1" link="data:page/id,page-02"><mxGeometry x="48" y="353" width="567" height="140" as="geometry" /></mxCell><mxCell id="p03" value="&lt;span style=&quot;font-size:22px;color:#10243A;font-weight:600&quot;&gt;03  Задачи и карточка задачи&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#647D91;font-weight:400&quot;&gt;/tasks&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#10243A;font-weight:400&quot;&gt;Найти работу, изменить её и обсудить&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#16B8B1;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1" link="data:page/id,page-03"><mxGeometry x="48" y="521" width="567" height="140" as="geometry" /></mxCell><mxCell id="p04" value="&lt;span style=&quot;font-size:22px;color:#10243A;font-weight:600&quot;&gt;04  Kanban и создание задачи&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#647D91;font-weight:400&quot;&gt;/kanban&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#10243A;font-weight:400&quot;&gt;Распределение работы и смена состояний&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#16B8B1;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1" link="data:page/id,page-04"><mxGeometry x="48" y="689" width="567" height="140" as="geometry" /></mxCell><mxCell id="p05" value="&lt;span style=&quot;font-size:22px;color:#10243A;font-weight:600&quot;&gt;05  Проекты&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#647D91;font-weight:400&quot;&gt;/projects&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#10243A;font-weight:400&quot;&gt;Состав команды и контекст задач&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#16B8B1;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1" link="data:page/id,page-05"><mxGeometry x="48" y="857" width="567" height="140" as="geometry" /></mxCell><mxCell id="p06" value="&lt;span style=&quot;font-size:22px;color:#10243A;font-weight:600&quot;&gt;06  Команда и сотрудники&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#647D91;font-weight:400&quot;&gt;/employees&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#10243A;font-weight:400&quot;&gt;Кадровая карточка и данные для расчётов&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#16B8B1;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1" link="data:page/id,page-06"><mxGeometry x="48" y="1025" width="567" height="140" as="geometry" /></mxCell><mxCell id="p07" value="&lt;span style=&quot;font-size:22px;color:#10243A;font-weight:600&quot;&gt;07  Аналитика загрузки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#647D91;font-weight:400&quot;&gt;/workload&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#10243A;font-weight:400&quot;&gt;Доступное время и занятость команды&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#16B8B1;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1" link="data:page/id,page-07"><mxGeometry x="48" y="1193" width="567" height="140" as="geometry" /></mxCell><mxCell id="p08" value="&lt;span style=&quot;font-size:22px;color:#10243A;font-weight:600&quot;&gt;08  Прогнозы текучести&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#647D91;font-weight:400&quot;&gt;/attrition&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#10243A;font-weight:400&quot;&gt;Оценка риска ухода и разбор причин&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#16B8B1;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1" link="data:page/id,page-08"><mxGeometry x="1185" y="185" width="567" height="140" as="geometry" /></mxCell><mxCell id="p09" value="&lt;span style=&quot;font-size:22px;color:#10243A;font-weight:600&quot;&gt;09  Отчёты и уведомления&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#647D91;font-weight:400&quot;&gt;/reports · /notifications&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#10243A;font-weight:400&quot;&gt;Сводка для руководителя и значимые события&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#16B8B1;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1" link="data:page/id,page-09"><mxGeometry x="1185" y="353" width="567" height="140" as="geometry" /></mxCell><mxCell id="p10" value="&lt;span style=&quot;font-size:22px;color:#10243A;font-weight:600&quot;&gt;10  Администрирование&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#647D91;font-weight:400&quot;&gt;/admin&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#10243A;font-weight:400&quot;&gt;Настройка предприятия и учётных записей&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#16B8B1;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1" link="data:page/id,page-10"><mxGeometry x="1185" y="521" width="567" height="140" as="geometry" /></mxCell><mxCell id="p11" value="&lt;span style=&quot;font-size:22px;color:#10243A;font-weight:600&quot;&gt;11  Управление моделями ML&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#647D91;font-weight:400&quot;&gt;/admin/ml/models&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#10243A;font-weight:400&quot;&gt;От истории сотрудников к рабочей версии модели&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#16B8B1;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1" link="data:page/id,page-11"><mxGeometry x="1185" y="689" width="567" height="140" as="geometry" /></mxCell><mxCell id="p12" value="&lt;span style=&quot;font-size:22px;color:#10243A;font-weight:600&quot;&gt;12  Роли и границы доступа&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#647D91;font-weight:400&quot;&gt;Роль → доступные действия&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#10243A;font-weight:400&quot;&gt;Как читать ограничения на остальных картах&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#16B8B1;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1" link="data:page/id,page-12"><mxGeometry x="1185" y="857" width="567" height="140" as="geometry" /></mxCell><mxCell id="p13" value="&lt;span style=&quot;font-size:22px;color:#10243A;font-weight:600&quot;&gt;13  Пользовательские маршруты&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#647D91;font-weight:400&quot;&gt;С чего начать → какой результат&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#10243A;font-weight:400&quot;&gt;Сценарии изучения и вопросы для следующего задания&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#16B8B1;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1" link="data:page/id,page-13"><mxGeometry x="1185" y="1025" width="567" height="140" as="geometry" /></mxCell><mxCell id="p14" value="&lt;span style=&quot;font-size:22px;color:#10243A;font-weight:600&quot;&gt;14  Фоновые процессы и API&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#647D91;font-weight:400&quot;&gt;Не отдельные кнопки в интерфейсе&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#10243A;font-weight:400&quot;&gt;Какая логика работает за пользовательским действием&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#16B8B1;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1" link="data:page/id,page-14"><mxGeometry x="1185" y="1193" width="567" height="140" as="geometry" /></mxCell><mxCell id="root" value="&lt;span style=&quot;font-size:26px;color:white;font-weight:600&quot;&gt;FlowStaff AI&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#B9E5E4;font-weight:400&quot;&gt;Где находится функция&lt;br&gt;Как она работает&lt;br&gt;Кому доступна&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#073F48;strokeColor=#073F48;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="760" y="705" width="280" height="190" as="geometry" /></mxCell><mxCell id="edge-0" source="root" target="p01" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#16B8B1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="800" /><mxPoint x="700" y="255" /></Array></mxGeometry></mxCell><mxCell id="edge-1" source="root" target="p02" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#16B8B1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="800" /><mxPoint x="700" y="423" /></Array></mxGeometry></mxCell><mxCell id="edge-2" source="root" target="p03" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#16B8B1;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoi