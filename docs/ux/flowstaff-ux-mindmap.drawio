ight="1800" background="#F3FAFC"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="page-title" value="01 · Вход и навигация" style="text;html=1;align=left;fontSize=30;fontFamily=Onest;fontStyle=1;fontColor=#10243A" vertex="1" parent="1"><mxGeometry x="48" y="35" width="1650" height="60" as="geometry" /></mxCell><mxCell id="page-subtitle" value="Ветви: раздел → функция → действие и результат. Ограничения роли указаны в каждом узле." style="text;html=1;align=left;fontSize=16;fontFamily=Onest;fontColor=#647D91" vertex="1" parent="1"><mxGeometry x="48" y="105" width="1650" height="50" as="geometry" /></mxCell><mxCell id="g-1_0" value="&lt;span style=&quot;font-size:20px;color:#109E99;font-weight:600&quot;&gt;Авторизация&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="417.33333333333337" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Войти&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · /login&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Ввести логин и пароль.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: После успеха открывается /dashboard.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Гость&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="295.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Ошибка входа&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · /login?error&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Исправить данные и повторить вход.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Ошибка не открывает рабочие страницы.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Гость&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="471.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_1" value="&lt;span style=&quot;font-size:20px;color:#277CCB;font-weight:600&quot;&gt;Боковое меню&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="894.0" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Основные разделы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Sidebar&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Выбрать задачу, проект, команду или аналитику.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Открывается соответствующая страница.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="766.5" width="405" height="171" as="geometry" /></mxCell><mxCell id="g-1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Мобильное меню&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Кнопка меню в TopBar&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Открыть выдвижную навигацию.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Контент остаётся в основной области.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="953.5" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_2" value="&lt;span style=&quot;font-size:20px;color:#7761C5;font-weight:600&quot;&gt;Быстрое действие&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="1370.6666666666667" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_2_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Создать задачу&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Sidebar → «Создать задачу»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Открывается /kanban?create=1.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Панель создания для выбранного проекта.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1248.6666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_2_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Поиск в TopBar&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · TopBar → строка поиска&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Ввести запрос; Ctrl/Cmd+K ставит фокус.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Сейчас ищет задачи через /tasks?q=…&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1424.6666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_0" value="&lt;span style=&quot;font-size:20px;color:#15966A;font-weight:600&quot;&gt;Переходы&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="417.33333333333337" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Моя страница&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Хлебные крошки → домик&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Нажать «Моя страница».&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Это главная /dashboard, не личный профиль.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="289.83333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Команда / Аналитика&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Sidebar&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: «Команда» → /employees; «Аналитика» → /workload.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Названия меню отличаются от заголовков.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="465.83333333333337" width="405" height="171" as="geometry" /></mxCell><mxCell id="g1_1" value="&lt;span style=&quot;font-size:20px;color:#C27B23;font-weight:600&quot;&gt;Аккаунт&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="894.0" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Текущая роль&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · TopBar → меню аккаунта&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Посмотреть имя и категорию роли.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Нет формы самостоятельной смены роли.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="772.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Выйти&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Меню аккаунта → «Выйти»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Завершить текущую сессию.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Открывается страница входа.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="948.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_2" value="&lt;span style=&quot;font-size:20px;color:#BB5266;font-weight:600&quot;&gt;Ограничения&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="1370.6666666666667" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_2_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Разделы по ролям&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Sidebar / контроллеры&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Открывать только разрешённые действия.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Скрытая кнопка не заменяет проверку сервера.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1243.1666666666667" width="405" height="171" as="geometry" /></mxCell><mxCell id="g1_2_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Не отдельные экраны&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;ВАЖНО · Текущий интерфейс&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Личный кабинет и чат ИИ не выделены.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Не считать их реализованными функциями.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1430.1666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="root" value="&lt;span style=&quot;font-size:26px;color:white;font-weight:600&quot;&gt;Вход и навигация&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#B9E5E4;font-weight:400&quot;&gt;/login&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#073F48;strokeColor=#073F48;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="760" y="845" width="280" height="190" as="geometry" /></mxCell><mxCell id="edge-0" source="root" target="g-1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="463.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-1" source="g-1_0" target="g-1_0_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#109E99;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="463.33333333333337" /><mxPoint x="477" y="375.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-2" source="g-1_0" target="g-1_0_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#109E99;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="463.33333333333337" /><mxPoint x="477" y="551.3333333333334" /></Array></mxGeometry></mxCell><mxCell id="edge-3" source="root" target="g-1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;roun