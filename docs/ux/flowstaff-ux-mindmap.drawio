metry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="940.0" /><mxPoint x="477" y="1028.0" /></Array></mxGeometry></mxCell><mxCell id="edge-6" source="root" target="g-1_2" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="1416.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-7" source="g-1_2" target="g-1_2_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#7761C5;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="1416.6666666666667" /><mxPoint x="477" y="1328.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-8" source="g-1_2" target="g-1_2_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#7761C5;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="1416.6666666666667" /><mxPoint x="477" y="1504.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-9" source="root" target="g1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="463.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-10" source="g1_0" target="g1_0_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#15966A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="463.33333333333337" /><mxPoint x="1323" y="375.33333333333337" /></Array></mxGeometry></mxCell><mxCell id="edge-11" source="g1_0" target="g1_0_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#15966A;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="463.33333333333337" /><mxPoint x="1323" y="551.3333333333334" /></Array></mxGeometry></mxCell><mxCell id="edge-12" source="root" target="g1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="940.0" /></Array></mxGeometry></mxCell><mxCell id="edge-13" source="g1_1" target="g1_1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#C27B23;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="940.0" /><mxPoint x="1323" y="852.0" /></Array></mxGeometry></mxCell><mxCell id="edge-14" source="g1_1" target="g1_1_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#C27B23;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="940.0" /><mxPoint x="1323" y="1028.0" /></Array></mxGeometry></mxCell><mxCell id="edge-15" source="root" target="g1_2" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1058" y="940" /><mxPoint x="1058" y="1416.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-16" source="g1_2" target="g1_2_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#BB5266;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="1416.6666666666667" /><mxPoint x="1323" y="1328.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="edge-17" source="g1_2" target="g1_2_1" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#BB5266;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1323" y="1416.6666666666667" /><mxPoint x="1323" y="1504.6666666666667" /></Array></mxGeometry></mxCell><mxCell id="legend" value="А — администратор; РП — предприятие; РОт — отдел; РПр — проект; С — сотрудник. UI — интерфейс; ФОН/API — без отдельного экрана; ИДЕЯ — предложение." style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontFamily=Onest;fontColor=#647D91;" vertex="1" parent="1"><mxGeometry x="48" y="1725" width="1650" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page-03" name="03 Задачи и карточка задачи"><mxGraphModel dx="1800" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1800" background="#F3FAFC"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="page-title" value="03 · Задачи и карточка задачи" style="text;html=1;align=left;fontSize=30;fontFamily=Onest;fontStyle=1;fontColor=#10243A" vertex="1" parent="1"><mxGeometry x="48" y="35" width="1650" height="60" as="geometry" /></mxCell><mxCell id="page-subtitle" value="Ветви: раздел → функция → действие и результат. Ограничения роли указаны в каждом узле." style="text;html=1;align=left;fontSize=16;fontFamily=Onest;fontColor=#647D91" vertex="1" parent="1"><mxGeometry x="48" y="105" width="1650" height="50" as="geometry" /></mxCell><mxCell id="g-1_0" value="&lt;span style=&quot;font-size:20px;color:#109E99;font-weight:600&quot;&gt;Поиск и отбор&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="417.33333333333337" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Найти задачу&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · /tasks&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Задать q, проект, статус, «мои» или просрочки.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Список показывает совпадающие задачи.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="295.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Открыть карточку&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Строка задачи → /tasks/{id}&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Нажать название задачи.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Описание, сроки, часы и участники.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#109E99;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="471.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_1" value="&lt;span style=&quot;font-size:20px;color:#277CCB;font-weight:600&quot;&gt;Изменения&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="894.0" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Редактировать задачу&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточка → «Редактировать»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Изменить параметры и сохранить форму.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Сохраняется новая версия записи.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="772.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Создание задачи&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Кнопка создания → Kanban&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Перейти в панель новой задачи.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Подробный процесс — на карте Kanban.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#277CCB;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="948.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g-1_2" value="&lt;span style=&quot;font-size:20px;color:#7761C5;font-weight:600&quot;&gt;Рабочий статус&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="505" y="1370.6666666666667" width="220" height="92" as="geometry" /></mxCell><mxCell id="g-1_2_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Изменить статус&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточка → список статусов&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Выбрать допустимое следующее состояние.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Для некоторых возвратов нужен комментарий.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр / С: своя задача&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1243.1666666666667" width="405" height="171" as="geometry" /></mxCell><mxCell id="g-1_2_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Конфликт изменения&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;ВАЖНО · Серверная проверка версии&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Обновить карточку после сообщения.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Устаревшая версия не затирает новую.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#7761C5;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="45" y="1430.1666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_0" value="&lt;span style=&quot;font-size:20px;color:#15966A;font-weight:600&quot;&gt;Чек-лист&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="417.33333333333337" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_0_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Добавить / удалить пункт&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточка → «Чек-лист»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Ввести пункт или удалить ненужный.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Изменяется список готовности задачи.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="295.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_0_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Отметить готовность&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Чек-лист → кнопка пункта&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Переключить отметку выполнения.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Сотрудник меняет пункты своей задачи.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: А / РП / РОт / РПр / С: своя задача&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#15966A;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="471.33333333333337" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_1" value="&lt;span style=&quot;font-size:20px;color:#C27B23;font-weight:600&quot;&gt;Обсуждение&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="894.0" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_1_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Добавить комментарий&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточка → «Комментарии»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Ввести текст и отправить.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Комментарий появляется в обсуждении.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="772.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_1_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;История статусов&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;ФОН · Сохранение статуса → база&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Система записывает переход и автора.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Отдельная лента истории в UI не выделена.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Система&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#C27B23;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="948.0" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_2" value="&lt;span style=&quot;font-size:20px;color:#BB5266;font-weight:600&quot;&gt;Связанные сущности&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#F7FBFC;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1075" y="1370.6666666666667" width="220" height="92" as="geometry" /></mxCell><mxCell id="g1_2_0" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;Проект / исполнитель&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Параметры справа&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Нажать ссылку проекта или сотрудника.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Открывается соответствующая карточка.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1248.6666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="g1_2_1" value="&lt;span style=&quot;font-size:18px;color:#10243A;font-weight:600&quot;&gt;На доске&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:400&quot;&gt;UI · Карточка → «На доске»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Как: Открыть Kanban проекта задачи.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#10243A;font-weight:400&quot;&gt;Итог: Сохраняется контекст выбранного проекта.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#647D91;font-weight:600&quot;&gt;Доступ: Все авторизованные&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=white;strokeColor=#BB5266;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1350" y="1424.6666666666667" width="405" height="160" as="geometry" /></mxCell><mxCell id="root" value="&lt;span style=&quot;font-size:26px;color:white;font-weight:600&quot;&gt;Задачи и карточка задачи&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#B9E5E4;font-weight:400&quot;&gt;/tasks&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Onest;fillColor=#073F48;strokeColor=#073F48;strokeWidth=1.5;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="760" y="845" width="280" height="190" as="geometry" /></mxCell><mxCell id="edge-0" source="root" target="g-1_0" edge="1" parent="1" style="endArrow=none;startArrow=none;rounded=1;html=1;strokeColor=#A8CBCD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="940" /><mxPoint x="742" y="463.333333