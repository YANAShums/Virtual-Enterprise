MYSQL_ROOT_PASSWORD=root_password_change_me
DB_USERNAME=virtual_app
DB_PASSWORD=virtual_app_password
WORKLOAD_SERVICE_TOKEN=change-me-internal-token
SESSION_TIMEOUT_MINUTES=30
