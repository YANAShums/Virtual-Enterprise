# Copy to .env.production (ignored by Git). Fill with unique values from a secret store.
# Never reuse the development credentials on a public deployment.
MYSQL_ROOT_PASSWORD=
CORE_DB_USERNAME=
CORE_DB_PASSWORD=
WORKLOAD_DB_USERNAME=
WORKLOAD_DB_PASSWORD=
ML_DB_USERNAME=
ML_DB_PASSWORD=
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=
WORKLOAD_SERVICE_TOKEN=
ML_SERVICE_TOKEN=
# Absolute directory containing PEM certificates/keys and CA truststore; see docs/DEPLOYMENT.md.
TLS_DIRECTORY=
HTTPS_BIND_ADDRESS=127.0.0.1
SESSION_TIMEOUT_MINUTES=30
MAX_FILE_SIZE_MB=20
BACKUP_DIRECTORY=
BACKUP_RETENTION_COUNT=7
BACKUP_INTERVAL_SECONDS=86400
